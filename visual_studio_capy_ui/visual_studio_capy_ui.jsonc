		//"menu.selectionBorder": null,
		//"minimap.background": null,
		//"notebook.cellHoverBackground": null,
		//"notebook.focusedCellBackground": null,
		//"notebook.inactiveSelectedCellBorder": null,
		//"notebook.outputContainerBackgroundColor": null,
		//"notebook.outputContainerBorderColor": null,
		//"outputView.background": null,
		//"outputViewStickyScroll.background": null,
		//"panelSectionHeader.border": null,
		//"panelSectionHeader.foreground": null,
		//"panelStickyScroll.border": null,
		//"panelTitle.border": null,
		//"peekViewEditor.matchHighlightBorder": null,
		//"quickInputList.focusIconForeground": null,
		//"radio.inactiveBackground": null,
		//"radio.inactiveForeground": null,
		//"scrollbar.background": null,
		//"searchEditor.findMatchBorder": null,
		//"selection.background": null,
		//"sideBarStickyScroll.border": null,
		//"sideBarTitle.border": null,
		//"terminal.findMatchBorder": null,
		//"terminal.findMatchHighlightBorder": null,
		//"terminal.selectionForeground": null,
		//"terminalCursor.background": null,
		//"terminalStickyScroll.background": null,
		//"terminalStickyScroll.border": null,
		//"terminalSymbolIcon.inlineSuggestionForeground": null,
		//"testing.message.error.lineBackground": null,
		//"testing.message.info.lineBackground": null,
		//"toolbar.hoverOutline": null,
		//"welcomePage.background": null,
		//"widget.border": null,
		//"window.activeBorder": null,
		//"window.inactiveBorder": null
	},
	"tokenColors": [
		{
			"scope": [
				"comment",
				"punctuation.definition.comment"
			],
			"settings": {
				"foreground": "#8BB4D8",
				"fontStyle": "italic"
			}
		},
		{
			"scope": [
				"string",
				"string.quoted",
				"string.template"
			],
			"settings": {
				"foreground": "#00BA7C"
			}
		},
		{
			"scope": [
				"constant.character.escape",
				"text.html.derivative"
			],
			"settings": {
				"foreground": "#4F5B6F"
			}
		},
		{
			"scope": [
				"constant.numeric",
				"constant.language.boolean",
				"constant.language.null",
				"constant.language.undefined"
			],
			"settings": {
				"foreground": "#4F5B6F"
			}
		},
		{
			"scope": [
				"variable",
				"variable.other"
			],
			"settings": {
				"foreground": "#F7F9F9"
			}
		},
		{
			"scope": [
				"variable.other.property",
				"variable.other.object.property",
				"support.variable.property"
			],
			"settings": {
				"foreground": "#8BB4D8"
			}
		},
		{
			"scope": [
				"keyword",
				"storage.type",
				"storage.modifier"
			],
			"settings": {
				"foreground": "#1E80C7",
				"fontStyle": "bold"
			}
		},
		{
			"scope": [
				"keyword.operator",
				"keyword.operator.logical",
				"keyword.operator.arithmetic",
				"keyword.operator.assignment",
				"keyword.operator.comparison"
			],
			"settings": {
				"foreground": "#5FF4AE"
			}
		},
		{
			"scope": [
				"entity.name.function",
				"support.function"
			],
			"settings": {
				"foreground": "#93ABD0"
			}
		},
		{
			"scope": [
				"entity.name.type",
				"entity.name.class",
				"support.type",
				"support.class"
			],
			"settings": {
				"foreground": "#BDBEC1"
			}
		},
		{
			"scope": [
				"entity.name.type.interface"
			],
			"settings": {
				"foreground": "#A0B0C0"
			}
		},
		{
			"scope": [
				"variable.parameter",
				"meta.parameters"
			],
			"settings": {
				"foreground": "#F7F9F9",
				"fontStyle": "italic"
			}
		},
		{
			"scope": [
				"entity.name.tag",
				"meta.tag"
			],
			"settings": {
				"foreground": "#1E80C7"
			}
		},
		{
			"scope": [
				"entity.other.attribute-name"
			],
			"settings": {
				"foreground": "#5FF4AE"
			}
		},
		{
			"scope": [
				"keyword.control.import",
				"keyword.control.export",
				"keyword.control.from"
			],
			"settings": {
				"foreground": "#1E80C7",
				"fontStyle": "bold"
			}
		},
		{
			"scope": [
				"entity.name.type.module",
				"support.module"
			],
			"settings": {
				"foreground": "#8BB4D8"
			}
		},
		{
			"scope": [
				"constant",
				"variable.other.constant"
			],
			"settings": {
				"foreground": "#4F5B6F"
			}
		},
		{
			"scope": [
				"support.constant",
				"support.variable"
			],
			"settings": {
				"foreground": "#8BB4D8"
			}
		},
		{
			"scope": [
				"invalid",
				"invalid.illegal"
			],
			"settings": {
				"foreground": "#E11D1D"
			}
		},
		{
			"scope": [
				"invalid.deprecated"
			],
			"settings": {
				"foreground": "#BDBEC1",
				"fontStyle": "strikethrough"
			}
		},
		{
			"scope": [
				"entity.other.attribute-name.id.css"
			],
			"settings": {
				"foreground": "#BDBEC1"
			}
		},
		{
			"scope": [
				"entity.other.attribute-name.class.css"
			],
			"settings": {
				"foreground": "#00BA7C"
			}
		},
		{
			"scope": [
				"support.type.property-name.css"
			],
			"settings": {
				"foreground": "#1E80C7"
			}
		},
		{
			"scope": [
				"support.type.property-name.json",
				"string.json support.type.property-name.json"
			],
			"settings": {
				"foreground": "#1E80C7"
			}
		},
		{
			"scope": [
				"markup.heading",
				"entity.name.section.markdown"
			],
			"settings": {
				"foreground": "#1E80C7",
				"fontStyle": "bold"
			}
		},
		{
			"scope": [
				"markup.bold"
			],
			"settings": {
				"foreground": "#F7F9F9",
				"fontStyle": "bold"
			}
		},
		{
			"scope": [
				"markup.italic"
			],
			"settings": {
				"foreground": "#F7F9F9",
				"fontStyle": "italic"
			}
		},
		{
			"scope": [
				"markup.underline.link",
				"string.other.link.title.markdown"
			],
			"settings": {
				"foreground": "#1E80C7"
			}
		},
		{
			"scope": [
				"markup.inline.raw",
				"markup.fenced_code.block.markdown"
			],
			"settings": {
				"foreground": "#00BA7C"
			}
		},
		{
			"scope": [
				"markup.quote"
			],
			"settings": {
				"foreground": "#8BB4D8",
				"fontStyle": "italic"
			}
		},
		{
			"scope": [
				"markup.deleted"
			],
			"settings": {
				"foreground": "#E11D1D"
			}
		},
		{
			"scope": [
				"markup.inserted"
			],
			"settings": {
				"foreground": "#00BA7C"
			}
		},
		{
			"scope": [
				"markup.changed"
			],
			"settings": {
				"foreground": "#BDBEC1"
			}
		},
		{
			"scope": [
				"string.regexp"
			],
			"settings": {
				"foreground": "#4F5B6F"
			}
		},
		{
			"scope": [
				"keyword.other.DML.sql"
			],
			"settings": {
				"foreground": "#1E80C7"
			}
		},
		{
			"scope": [
				"variable.language.special.self.python"
			],
			"settings": {
				"foreground": "#4F5B6F",
				"fontStyle": "italic"
			}
		},
		{
			"scope": [
				"entity.name.function.decorator.python"
			],
			"settings": {
				"foreground": "#BDBEC1"
			}
		},
		{
			"scope": [
				"variable.language.this"
			],
			"settings": {
				"foreground": "#4F5B6F",
				"fontStyle": "italic"
			}
		},
		{
			"scope": [
				"entity.name.type.ts",
				"entity.name.type.tsx"
			],
			"settings": {
				"foreground": "#BDBEC1"
			}
		},
		{
			"scope": [
				"support.class.component.tsx",
				"support.class.component.jsx"
			],
			"settings": {
				"foreground": "#A0B0C0"
			}
		},
		{
			"scope": [
				"punctuation",
				"punctuation.separator",
				"punctuation.terminator",
				"punctuation.definition",
				"punctuation.section",
				"meta.brace",
				"meta.brace.round",
				"meta.brace.square",
				"meta.brace.curly",
				"punctuation.definition.typeparameters.begin.ts",
				"punctuation.definition.typeparameters.end.ts",
				"punctuation.definition.parameters.begin.ts",
				"punctuation.definition.parameters.end.ts",
				"punctuation.definition.block.ts",
				"meta.brace.round.ts",
				"meta.brace.square.ts",
				"meta.brace.curly.ts"
			],
			"settings": {
				"foreground": "#5FF4AE"
			}
		},
		{
			"scope": "token.info-token",
			"settings": {
				"foreground": "#6796E6"
			}
		},
		{
			"scope": "token.warn-token",
			"settings": {
				"foreground": "#CD9731"
			}
		},
		{
			"scope": "token.error-token",
			"settings": {
				"foreground": "#F44747"
			}
		},
		{
			"scope": "token.debug-token",
			"settings": {
				"foreground": "#B267E6"
			}
		}
	]
}